@model IEnumerable<CLDV2026.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1 class="mb-4">📅 Bookings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Create New Booking</a>
</p>
<form method="get" asp-action="Index" class="row g-3 mb-4">

    <!-- Search -->
    <div class="col-md-3">
        <input type="text"
               name="searchTerm"
               class="form-control"
               placeholder="Booking ID or Event Name"
               value="@ViewBag.SearchTerm" />
    </div>

    <!-- Event Type -->
    <div class="col-md-2">
        <select name="eventTypeId" class="form-select">
            <option value="">All Event Types</option>

            @foreach (var type in ViewBag.EventTypes)
            {
                if (ViewBag.EventTypeId != null &&
                ViewBag.EventTypeId == type.EventTypeId)
                {
                    <option value="@type.EventTypeId" selected>
                        @type.Name
                    </option>
                }
                else
                {
                    <option value="@type.EventTypeId">
                        @type.Name
                    </option>
                }
            }
        </select>
    </div>

    <!-- Venue Availability -->
    <div class="col-md-2">
        <select name="isAvailable" class="form-select">
            <option value="">All Venues</option>

            @if (ViewBag.IsAvailable?.ToString() == "True")
            {
                <option value="true" selected>Available</option>
            }
            else
            {
                <option value="true">Available</option>
            }

            @if (ViewBag.IsAvailable?.ToString() == "False")
            {
                <option value="false" selected>Unavailable</option>
            }
            else
            {
                <option value="false">Unavailable</option>
            }
        </select>
    </div>

    <!-- Start Date -->
    <div class="col-md-2">
        <input type="date"
               name="startDate"
               class="form-control"
               value="@ViewBag.StartDate" />
    </div>

    <!-- End Date -->
    <div class="col-md-2">
        <input type="date"
               name="endDate"
               class="form-control"
               value="@ViewBag.EndDate" />
    </div>

    <!-- Search Button -->
    <div class="col-md-1 d-grid">
        <button type="submit" class="btn btn-success">
            Search
        </button>
    </div>

    <!-- Clear Button -->
    <div class="col-md-2 d-grid">
        <a asp-action="Index" class="btn btn-secondary">
            Clear Filters
        </a>
    </div>

</form>
<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Event</th>
            <th>Venue</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <!-- ✅ Formatted Date -->
                <td>@item.BookingDate.ToShortDateString()</td>

                <!-- ✅ Show Event Name instead of ID -->
                <td>@item.Event?.EventName</td>

                <!-- ✅ Show Venue Name instead of ID -->
                <td>@item.Venue?.VenueName</td>

                <!-- ✅ Styled Buttons -->
                <td>
                    <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>